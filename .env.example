# Copy to .env.local for local runs; set the same names in Vercel > Settings > Environment Variables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres   # Supabase transaction pooler URI (required)
GEMINI_API_KEY=                                              # Google AI Studio key (required for the AI copilot)
SESSION_SECRET=                                              # any long random string; signs the login cookie
GEMINI_MODEL=                                                # optional: force a model name
SETUP_KEY=                                                   # optional: lets you re-run /api/setup without a head login
